LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LLM runs locally via Ollama — no key needed. qwen3:8b is faster but makes up events and skips tools far more often.
OLLAMA_MODEL=qwen3:14b
PORT=3000

# Optional
# OLLAMA_URL=http://localhost:11434       # where Ollama is; docker-compose sets this for you
# OLLAMA_THINK=1                          # let the model reason before every reply: more careful, ~3x slower
# REPLY_MODE=text                         # plain-text replies instead of Flex (demo-day fallback)
# DEMO_NOW=2026-09-13T20:00:00+07:00      # pin "now" so relative dates hit the mock data (covers 13 Sep – 4 Oct 2026)
# REMINDER_DEMO_SECONDS=60                # send booking reminders 60s after booking instead of on the event day
